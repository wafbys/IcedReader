{
  "name": "iced-reader",
  "private": true,
  "version": "0.14.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "check:ui": "node ui/src/pdfPaging.check.ts",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint": "npm run typecheck && npm run lint:rust",
    "test:rust": "cargo test --workspace",
    "test": "npm run check:ui && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
